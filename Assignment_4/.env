# ---------------------------------------------------------------------------
# TaskPing environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Expo app (client) ---
# Public values are exposed to the client bundle via the EXPO_PUBLIC_ prefix.
# Use your machine's LAN IP when testing on a physical device (not localhost).
EXPO_PUBLIC_BACKEND_URL=http://10.2.26.235:4000

# Low-trust shared key sent with backend requests (must match backend API_KEY).
EXPO_PUBLIC_API_KEY=dev-public-key

# Your EAS project id (required to fetch push tokens on a real build).
EXPO_PUBLIC_EAS_PROJECT_ID=9fe00952-8477-48bb-917a-bd3698174238
# --- Backend (server) ---
# Port the Express server listens on.
PORT=4000

# Shared API key the server validates on protected routes.
# Keep this secret in production; rotate regularly.
API_KEY=dev-public-key
